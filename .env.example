# Firebase — copy from your Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary — unsigned upload preset (create in Cloudinary Console > Settings > Upload)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Default UPI merchant details (can be overridden per-shop in Settings)
VITE_DEFAULT_UPI_ID=
VITE_DEFAULT_MERCHANT_NAME=
